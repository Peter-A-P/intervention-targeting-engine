# Private working notes, never committed
CLAUDE.local.md

# Secrets
.env
.env.*

# Raw and cached data (loaders download and verify checksums)
data/raw/
data/cache/

# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
dist/
build/
*.egg-info/

# Interrupted benchmark runs. A checkpoint on disk means a run was killed and can be
# resumed; it is never a result, so committing one would put a half-finished table in the
# history and invite somebody to read it as a finished one.
results/*.checkpoint.json

# Demo build output
demo/dist/

# OS and editors
.DS_Store
Thumbs.db
.vscode/
.idea/
